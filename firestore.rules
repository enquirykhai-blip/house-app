rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isHousehold() {
      return request.auth != null &&
        (request.auth.uid == "KHAI_UID" || request.auth.uid == "WIFE_UID");
    }
    match /{document=**} {
      allow read, write: if isHousehold();
    }
  }
}
